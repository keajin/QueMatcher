{
  "name": "quematcher",
  "version": "0.1.0",
  "description": "Offline badminton social session organizer",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "electron .",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/app.js && node --check src/model.js && node --check src/configurations.js && node --check src/display-state.js && node --check src/display.js && node --check desktop/display-board.cjs && node --check desktop/display-preload.cjs && node --check desktop/setup-storage.js && node --check desktop/main.cjs && node --check desktop/preload.cjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.quematcher.desktop",
    "productName": "QueMatcher",
    "files": ["index.html", "display.html", "PSOQ_Logo.jpg", "src/**/*", "desktop/**/*", "package.json"],
    "directories": { "output": "release" },
    "mac": { "target": ["dmg"], "category": "public.app-category.sports" },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
